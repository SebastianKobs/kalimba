# The deploy's settings. Copy to deploy/.env (gitignored) and fill in here: `npm run image` reads it,
# and it's copied to the docker machine next to docker-compose.yml, which reads it there (see README.md)

# where it goes: the docker machine as ssh knows it, as the kalimba's own user (kalimba@server, or an ~/.ssh/config alias),
# its folder there (that user's home), its platform
HOST=kalimba@docker.lan
DIR=~
PLATFORM=linux/amd64

# how it's served there: the host name, and Traefik's names if yours differ from these defaults
KALIMBA_HOST=kalimba.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
